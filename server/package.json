{
  "name": "antoniotrinidad-backend",
  "version": "0.1.0",
  "description": "Backend MERN para portafolio profesional y blog tecnico.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "create:admin": "node src/scripts/createAdmin.js",
    "reset:admin-password": "node src/scripts/resetAdminPassword.js",
    "check": "npm run lint && node --check src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "keywords": [
    "mern",
    "portfolio",
    "blog",
    "express",
    "mongodb"
  ],
  "author": "Antonio Trinidad",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  }
}
